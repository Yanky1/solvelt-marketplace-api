<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Solvelt.PayConnector</RootNamespace>
    <AssemblyName>Solvelt.PayConnector</AssemblyName>
    <!-- The one place in this repository that touches card numbers (decision V-13, owner-confirmed). Nothing else may reference this project except its tests. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- Pin: the version the bundle pulls transitively has a known high-severity advisory (GHSA-2m69-gcr7-jv3q), as in the API project. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Solvelt.PayConnector.Tests" />
    <InternalsVisibleTo Include="Solvelt.Marketplace.Api.Tests" />
  </ItemGroup>
</Project>
