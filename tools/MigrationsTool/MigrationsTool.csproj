<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Design-time host for `dotnet ef` only (never deployed, never referenced by the API or the tests). Migrations are generated from here for PostgreSQL, the production provider:
      dotnet ef migrations add NAME with the options project = src/Solvelt.Marketplace.Api, startup-project = tools/MigrationsTool, output-dir = Data/Migrations (see docs/DECISIONS.md M1-84)
    EF's design package pulls System.Security.Cryptography.Pkcs 9.0.0 transitively (NuGet advisories GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); it is build tooling, and keeping it
    in this project keeps it out of the API's dependencies. The audit is switched off for THIS project only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <ProjectReference Include="..\..\src\Solvelt.Marketplace.Api\Solvelt.Marketplace.Api.csproj" />
  </ItemGroup>
</Project>
